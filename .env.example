# Copy to .env and fill in real values. Never commit .env.
# Any platform left blank is reported as "failed: Not configured" and skipped.

PLATFORM_TIMEOUT_SECONDS=15
PUBLIC_CHECK_TIMEOUT_SECONDS=5
LOG_FILE=logs/posting.log

# Telegram: bot from @BotFather, added as admin of a PUBLIC channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_public_channel

# Mastodon: Preferences > Development > New application (scope write:statuses)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# GitHub: fine-grained token with only "Gists: write" (or classic token with "gist" scope)
GITHUB_TOKEN=

# Bluesky: Settings > Privacy and security > App passwords (not your account password)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# DEV.to: Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# Hugging Face: write token + one public repo you own (model, dataset or space)
HF_TOKEN=
HF_REPO_ID=yourname/automated-posting
HF_REPO_TYPE=dataset

# Discord: Server settings > Integrations > Webhooks > Copy webhook URL
DISCORD_WEBHOOK_URL=
